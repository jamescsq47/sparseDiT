ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-12.6/bin/nvcc

cflags = -pthread -B /mnt/public/chensiqi/anaconda3/envs/para/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /mnt/public/chensiqi/anaconda3/envs/para/include -fPIC -O2 -isystem /mnt/public/chensiqi/anaconda3/envs/para/include -fPIC -I/mnt/public/chensiqi/anaconda3/envs/para/lib/python3.10/site-packages/torch/include -I/mnt/public/chensiqi/anaconda3/envs/para/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/mnt/public/chensiqi/anaconda3/envs/para/lib/python3.10/site-packages/torch/include/TH -I/mnt/public/chensiqi/anaconda3/envs/para/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-12.6/include -I/mnt/public/chensiqi/anaconda3/envs/para/include/python3.10 -c
post_cflags = -g -O3 -fopenmp -lgomp -std=c++17 -DENABLE_BF16 -D_GLIBCXX_USE_CXX11_ABI=0 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_fused -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -I/mnt/public/chensiqi/anaconda3/envs/para/lib/python3.10/site-packages/torch/include -I/mnt/public/chensiqi/anaconda3/envs/para/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/mnt/public/chensiqi/anaconda3/envs/para/lib/python3.10/site-packages/torch/include/TH -I/mnt/public/chensiqi/anaconda3/envs/para/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-12.6/include -I/mnt/public/chensiqi/anaconda3/envs/para/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -std=c++17 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ --use_fast_math --threads=8 -Xptxas=-v -diag-suppress=174 -D_GLIBCXX_USE_CXX11_ABI=0 -gencode arch=compute_80,code=sm_80 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_fused -D_GLIBCXX_USE_CXX11_ABI=0
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /mnt/public/chensiqi/SpargeAttn/build/temp.linux-x86_64-cpython-310/csrc/fused/fused.o: cuda_compile /mnt/public/chensiqi/SpargeAttn/csrc/fused/fused.cu
build /mnt/public/chensiqi/SpargeAttn/build/temp.linux-x86_64-cpython-310/csrc/fused/pybind.o: compile /mnt/public/chensiqi/SpargeAttn/csrc/fused/pybind.cpp






